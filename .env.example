# Переменные окружения сервера (прод). Скопируй в окружение systemd (см. docs/DEPLOY.md).
# Локально для разработки НЕ нужны — есть дефолты.

# Порт HTTP+WS сервера.
PORT=3001

# Путь к файлу SQLite (аккаунты/персонажи/конфиг-оверрайды). На VPS — на ПОСТОЯННОМ диске,
# чтобы данные пережили рестарт/редеплой. Директория создаётся автоматически.
DM_DB=/opt/dm/data/dm.db

# production — отключает dev-роут правки конфига (/api/dev/config) как анти-чит.
NODE_ENV=production

# (опц.) Явный путь к собранному клиенту, если не рядом (по умолчанию packages/client/dist).
# CLIENT_DIST=/opt/dm/packages/client/dist
