{
  "name": "dungeon-master",
  "version": "0.1.0",
  "private": true,
  "description": "Браузерный dungeon-crawler в духе Diablo 2 (модульный, data-driven)",
  "workspaces": [
    "packages/shared",
    "packages/client",
    "packages/server",
    "packages/editor"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev -w @dm/client",
    "dev:server": "npm run dev -w @dm/server",
    "editor": "npm run dev -w @dm/editor",
    "build": "npm run build -w @dm/shared && npm run build -w @dm/client",
    "start": "tsx packages/server/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx packages/server/src/sim-cli.ts",
    "lint": "eslint .",
    "loadtest": "tsx packages/server/src/loadtest/run.ts",
    "bench:ramp": "tsx packages/server/src/loadtest/bench.ts",
    "loadtest:server": "tsx packages/server/src/loadtest/probe.ts",
    "poc:dupe": "tsx packages/server/src/loadtest/dupe.ts",
    "bench:input": "tsx packages/server/src/loadtest/inputbench.ts",
    "bench:tick": "tsx packages/server/src/loadtest/tick.ts",
    "watch:anomalies": "tsx packages/server/src/db/watchCli.ts",
    "items:audit": "tsx packages/server/src/db/itemsCli.ts audit",
    "items:history": "tsx packages/server/src/db/itemsCli.ts history",
    "items:rollback": "tsx packages/server/src/db/itemsCli.ts rollback",
    "items:revoke": "tsx packages/server/src/db/itemsCli.ts revoke",
    "grant-admin": "tsx packages/server/src/db/roleCli.ts grant",
    "revoke-admin": "tsx packages/server/src/db/roleCli.ts revoke",
    "admins": "tsx packages/server/src/db/roleCli.ts list",
    "db:repair": "tsx packages/server/src/db/repairConfig.ts",
    "db:import": "tsx packages/server/src/db/importFromSqlite.ts",
    "poc:cluster": "tsx packages/server/src/loadtest/cluster.ts",
    "poc:cheat": "tsx packages/server/src/loadtest/cheat.ts",
    "poc:flood": "tsx packages/server/src/loadtest/flood.ts",
    "poc:delta": "tsx packages/server/src/loadtest/deltacheck.ts",
    "golden:wire": "tsx packages/server/src/loadtest/golden.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
