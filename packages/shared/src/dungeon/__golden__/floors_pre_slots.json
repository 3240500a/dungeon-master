l_statue_04"],"min":1,"max":2,"corridorChance":0.15,"width":2},"firePits":{"objectIds":["crypt_fire_pit_01","crypt_fire_pit_02"],"minRoom":7,"chance":0.6}},"decorDensity":{"chancePerRoom":1,"maxPerRoom":2,"areaPerSlot":60}},{"id":"caves","name":"Логова Крови и Зверя","enabled":true,"tileset":"tiles-caves","desc":"Наследие Империи Крови и Зверя — гнилые лесные глубины, подземные зверинцы и ритуальные ямы. Держава пыталась создать идеального солдата, смешивая кровь людей, зверей и магических существ. Сначала получили могучих воинов, потом — стаи, потом — голод, который нельзя остановить. Подземные лаборатории стали логовами проклятых зверолюдей и мутировавших созданий.","tagline":"\"Полное слияние уничтожает личность.\"","faction":"beast","enemies":["зверолюди","оборотни","мутировавшие хищники","гибриды человека и зверя","каннибалы","альфа-чудовища"],"monsterPool":["zombie","zombie"],"dropBias":1.1,"modifiers":[],"variants":[],"pillars":true,"torches":true,"decorDensity":{"chancePerRoom":1,"maxPerRoom":2,"areaPerSlot":60}},{"id":"dungeon","name":"Эфирные Архивы","enabled":true,"tileset":"tiles-dungeon","desc":"Наследие Империи Эфирных Архивов — подземные реакторы, кристальные башни, библиотеки заклинаний и машины, удерживающие эфир. Держава сделала ставку на чистую магическую науку, веря, что магию можно измерить, разделить и хранить как топливо. Но магия оказалась живой силой: архивы начали думать сами, машины вышли из-под контроля, а заклинания обрели волю.","tagline":"\"Человек стал лишним в собственном создании.\"","faction":"monster","enemies":["големы","магические конструкты","безумные архивариусы","живые руны","кристальные мутанты","искажённые маги"],"monsterPool":["zombie","zombie-archer"],"dropBias":1,"modifiers":[],"variants":[],"pillars":true,"torches":true,"decorDensity":{"chancePerRoom":1,"maxPerRoom":2,"areaPerSlot":60}},{"id":"labyrinth","name":"Врата Разлома","enabled":true,"tileset":"tiles-labyrinth","desc":"Наследие Империи Разлома — демоны, культисты, искажённая архитектура и порталы в нижние планы. Держава пошла дальше всех: её правители открывали разломы, заключали договоры с демонами и призывали сущностей из-за границы реальности как оружие против других держав. Но демоны пришли не служить — они пришли забрать долг. Глубочайшие уровни уже частично принадлежат иному измерению.","tagline":"\"Ты не можешь быть хозяином стихии — ты всего лишь её инструмент.\"","faction":"demon","enemies":["демоны","одержимые","культисты","искажённые рыцари","адские твари","бывшие императоры, ставшие демонами"],"monsterPool":["zombie","zombie-archer"],"dropBias":1,"modifiers":[],"variants":[],"pillars":true,"torches":true,"decorDensity":{"chancePerRoom":1,"maxPerRoom":2,"areaPerSlot":60}}],"floors":[{"id":"crypt-halls","name":"Залы некрополя","enabled":true,"desc":"Обычный боевой этаж — прямоугольные погребальные залы.","role":"combat","biomeId":"crypt","templates":[],"algoParams":{"algorithm":"bsp","cols":50,"rows":40,"splitDepth":4,"minLeaf":9,"roomPad":1,"loops":0.45,"spawnMode":"farthest","shapes":{"rect":4,"ell":0,"blob":0,"round":2,"hall":3},"prefabChance":1,"largeRoomArea":60},"features":{"portal":false,"shop":false,"bossRoom":false,"uniqueRooms":0,"treasureRooms":0},"packDensity":1,"minDepth":1,"maxDepth":5,"weight":3},{"id":"crypt-catacombs","name":"Глубокие катакомбы","enabled":true,"desc":"Боевой этаж поглубже — тесный лабиринт склепов.","role":"combat","biomeId":"crypt","templates":[],"algoParams":{"algorithm":"bsp","cols":70,"rows":50,"splitDepth":4,"minLeaf":9,"roomPad":1,"loops":0.45,"spawnMode":"farthest","shapes":{"rect":4,"ell":2,"blob":2,"round":2,"hall":2},"prefabChance":0,"largeRoomArea":80},"features":{"portal":false,"shop":false,"bossRoom":false,"uniqueRooms":0,"treasureRooms":0},"packDensity":1,"minDepth":5,"maxDepth":15,"weight":3},{"id":"crypt-elite","name":"Чертог стражей","enabled":true,"desc":"Этаж с усиленными пачками — несколько комнат заняты чемпионами.","role":"elite","biomeId":"crypt","templates